# Секреты агента и MCP: cp agent/.env.example agent/.env (реальные значения не коммитятся)

# LLM-провайдер (OpenAI-совместимый)
LLM_BASE_URL=https://api.example.com/v1
LLM_TOKEN=sk-REPLACE_ME
LLM_MODEL=qwen3.7-flash

# Логикор Earth — Mars API стенд
LOGIQ_URL=http://<stand-ip>:5555
LOGIQ_USER=admin
LOGIQ_PASSWORD=REPLACE_ME
LOGIQ_TLS_VERIFY=false

# MCP logicore-mcp: токен streamable-http (сервер поднимается с LOGIQ_AUTH=token)
LOGIQ_API_TOKEN=REPLACE_ME
