# docker compose переменные: cp .env.example .env (файл .env не коммитится)

# Пароль postgres локальной стопки (dev-значение по умолчанию — можно не менять)
POSTGRES_PASSWORD=aegra_password

# anomaly-relay: токен нативного аномали-вебхука Логикора (пусто — auth не проверяется)
RELAY_TOKEN=

# anomaly-relay: куда по умолчанию доставлять готовый отчёт (callback_url)
DEFAULT_CALLBACK_URL=
