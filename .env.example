# Единственный файл секретов: cp .env.example .env (сам .env не коммитится)
# Используется одновременно docker compose (POSTGRES_PASSWORD, RELAY_TOKEN, DEFAULT_CALLBACK_URL)
# и передаётся в контейнеры aegra + logicore-mcp (LLM_*, LOGIQ_*) через env_file.

# LLM-провайдер (OpenAI-совместимый)
LLM_BASE_URL=https://api.example.com/v1
LLM_TOKEN=sk-REPLACE_ME
LLM_MODEL=qwen3.7-flash
# Необязательные модели по ролям; пустое значение = LLM_MODEL
LLM_MODEL_INTENT=
LLM_MODEL_SCOUT=
LLM_MODEL_INVESTIGATOR=
LLM_MODEL_REPORTER=
LLM_MODEL_CRITIC=
LLM_MODEL_MEMORY=
LLM_MODEL_EVALUATOR=
LLM_MODEL_PLANNER=
SUMMARIZATION_TRIGGER_TOKENS=6000
SUMMARIZATION_KEEP_MESSAGES=20

# Лимиты одного agent.ainvoke и размеры контекста
AGENT_TOOL_LIMIT_SCOUT=10
AGENT_TOOL_LIMIT_INVESTIGATOR=30
AGENT_TOOL_LIMIT_REPORTER=60
AGENT_MAX_CONTINUATIONS=1
INVESTIGATION_PLANNER_ENABLED=true
PLANNER_MAX_ITEMS=5
PLANNER_MAX_PARALLEL=2
PLANNER_MAX_REVISIONS=2
SCOPE_DISCOVERY_MAX_ITEMS=2
SCOPE_REQUIRED_MAX_ITEMS=2
AGENT_PROMPT_VERSION=2026-11-03
AGENT_TIMEOUT_SECONDS=600
EXPORT_TIMEOUT_SECONDS=120
MAX_REWORK=1
CRITIC_MESSAGE_LIMIT=2000
CRITIC_DIALOG_LIMIT=8000
REPORT_INJECT_LIMIT=8000

# Независимая фоновая оценка завершённых runs по Phoenix
EVALUATOR_ENABLED=true
EVALUATOR_POLL_SECONDS=20
EVALUATOR_THREAD_LIMIT=25
EVALUATOR_TIMEOUT_SECONDS=120
EVALUATOR_TRACE_ATTEMPTS=15
EVALUATOR_TRACE_ATTRIBUTE_LIMIT=2500
EVALUATOR_PHOENIX_ANNOTATIONS_ENABLED=true
EXPERIMENT_TIMEOUT_SECONDS=900
PHOENIX_PROJECT=logicore-agent
PHOENIX_PUBLIC_URL=http://localhost:6006
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=30

# Файлы расследований в SeaweedFS S3; signed URL действует 1 час
ARTIFACT_STORE_BACKEND=s3
ARTIFACT_S3_ENDPOINT=http://seaweedfs:8333
ARTIFACT_S3_PUBLIC_ENDPOINT=http://localhost:8333
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=logicore-investigations
ARTIFACT_S3_ACCESS_KEY=agent
ARTIFACT_S3_SECRET_KEY=REPLACE_ME
ARTIFACT_S3_PREFIX=investigations
ARTIFACT_SIGNED_URL_TTL_SECONDS=3600
ARTIFACT_INLINE_FALLBACK_BYTES=262144
# Bearer для внешнего MCP агента: http://localhost:9100/mcp
AGENT_MCP_TOKEN=REPLACE_ME

# Логикор Earth — Mars API стенд
LOGIQ_URL=http://<stand-ip>:5555
LOGIQ_USER=admin
LOGIQ_PASSWORD=REPLACE_ME
LOGIQ_TLS_VERIFY=false

# MCP logicore-mcp: токен streamable-http (сервер поднимается с LOGIQ_AUTH=token)
LOGIQ_API_TOKEN=REPLACE_ME

# docker compose переменные
POSTGRES_PASSWORD=aegra_password
AGENT_MEMORY_POSTGRES_PASSWORD=agent_memory_password
AGENT_MEMORY_RECENT_LIMIT=3
AGENT_MEMORY_SCOPE=default
AGENT_MEMORY_RETRIEVAL_LIMIT=5
AGENT_MEMORY_CASE_RETRIEVAL_LIMIT=3
AGENT_MEMORY_CONSOLIDATION_CANDIDATES=10
AGENT_MEMORY_MAX_OPERATIONS=8
AGENT_MEMORY_SIMILARITY_THRESHOLD=0.10
AGENT_MEMORY_DEDUP_THRESHOLD=0.90
AGENT_MEMORY_OBSERVED_TTL_HOURS=24
AGENT_MEMORY_EMBEDDING_MODEL=bge-m3
AGENT_MEMORY_EMBEDDING_DIMENSIONS=1024
# Необязательно: отдельный OpenAI-совместимый endpoint embeddings; пусто = LLM_*
AGENT_MEMORY_EMBEDDING_BASE_URL=
AGENT_MEMORY_EMBEDDING_TOKEN=
RELAY_TOKEN=
DEFAULT_CALLBACK_URL=

# Опциональный scripts/deploy_ma.py; секреты только в локальном окружении
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_GIT_URL=https://gitlab.example.com/org/repository.git
DEPLOY_REMOTE_PATH=/opt/logicore_agent
