        },
        {
          "name": "hit_count",
          "category": "dynamic",
          "type": "integer",
          "required": true,
          "source": "$.payload.body.hit_count"
        },
        {
          "name": "hit_qualifier",
          "category": "dynamic",
          "type": "string",
          "required": false,
          "source": "$.payload.body.hit_qualifier"
        },
        {
